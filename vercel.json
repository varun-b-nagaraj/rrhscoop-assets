{
  "rewrites": [
    {
      "source": "/iframes/leadership.html",
      "destination": "/iframes/leadership/index.html"
    },
    {
      "source": "/iframes/leadership-embed.html",
      "destination": "/iframes/leadership/embed.html"
    },
    {
      "source": "/iframes/faq.html",
      "destination": "/iframes/faq/index.html"
    },
    {
      "source": "/iframes/faq-embed.html",
      "destination": "/iframes/faq/embed.html"
    },
    {
      "source": "/iframes/cfa.html",
      "destination": "/iframes/cfa/index.html"
    },
    {
      "source": "/iframes/cfa-embed.html",
      "destination": "/iframes/cfa/embed.html"
    },
    {
      "source": "/iframes/why-coop.html",
      "destination": "/iframes/why-coop/index.html"
    },
    {
      "source": "/iframes/why-coop-embed.html",
      "destination": "/iframes/why-coop/embed.html"
    },
    {
      "source": "/iframes/assets/(.*)",
      "destination": "/iframes/leadership/assets/$1"
    },
    {
      "source": "/v1/chat",
      "destination": "/api/v1/chat/proxy"
    },
    {
      "source": "/v1/ecwid/discount-url",
      "destination": "/api/v1/ecwid/discount-url"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS, GET, HEAD"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Discount-Secret"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/v1/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "POST, OPTIONS, GET, HEAD"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization, X-Discount-Secret"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, HEAD, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
